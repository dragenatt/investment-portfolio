{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/snapshots",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/baselines",
      "schedule": "35 14 * * 1-5"
    }
  ]
}
