# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Market Data (Twelve Data — free at twelvedata.com, 800 calls/day)
# If not set, Yahoo Finance is used as fallback automatically
TWELVE_DATA_API_KEY=

# Sentry (free plan). Leave empty to disable error reporting entirely —
# the SDK no-ops and the app behaves exactly as it did before.
# SENTRY_DSN is read by the server and edge runtimes; the browser can only see
# NEXT_PUBLIC_ variables, so the client needs its own copy of the same DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time. Without it the build skips
# the upload instead of failing.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (free plan). Leave empty to disable product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Comma-separated emails allowed into /admin/metrics. Empty means nobody.
ADMIN_EMAILS=
