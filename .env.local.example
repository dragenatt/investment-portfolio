# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Market Data (Twelve Data — free at twelvedata.com, 800 calls/day)
# If not set, Yahoo Finance is used as fallback automatically
TWELVE_DATA_API_KEY=

# Sentry (free plan). Leave empty to disable error reporting entirely —
# the SDK no-ops and the app behaves exactly as it did before.
# SENTRY_DSN is read by the server and edge runtimes; the browser can only see
# NEXT_PUBLIC_ variables, so the client needs its own copy of the same DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time. Without it the build skips
# the upload instead of failing.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (free plan). Leave empty to disable product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Risk-free rate (P0-5). All optional.
#
# Banxico SIE token (free at banxico.org.mx/SieAPIRest) unlocks CETES 28 dias as
# the MXN source. Without it, MXN falls back to the OECD 3-month interbank rate,
# which needs no credentials. USD (US Treasury) and EUR (ECB) never need a key.
BANXICO_API_TOKEN=
#
# Manual override used only when no publisher answers — an annual percentage,
# written the way the publishers write it: 7.45 means 7.45%.
RISK_FREE_RATE_MXN=
RISK_FREE_RATE_USD=
RISK_FREE_RATE_EUR=

# Feature flags (P1-24). All optional — each has a documented default in
# src/lib/services/feature-flags.ts and only needs setting to override it.
# Accepts 1/true/on/yes/enabled and 0/false/off/no/disabled; anything else falls
# back to the default rather than silently disabling a working feature.
#
# FEATURE_MONTE_CARLO=
# FEATURE_BACKTESTING=
# FEATURE_WALK_FORWARD=
# FEATURE_MARKOWITZ=
# FEATURE_AUDIT_TRAIL=      # needs migration 013 applied
# FEATURE_NOTIFICATIONS=    # needs migration 013 applied

# Comma-separated emails allowed into /admin/metrics. Empty means nobody.
ADMIN_EMAILS=
